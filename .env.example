# ------------------------------------------------------------------
# Life RPG — environment variables
# Copy this file to `.env` and fill in the values.
# ------------------------------------------------------------------

# ---- Database ----
# LOCAL DEV (default): SQLite, zero-config.
DATABASE_URL="file:./dev.db"
#
# PRODUCTION: use a hosted Postgres and change the datasource provider in
# prisma/schema.prisma from "sqlite" to "postgresql", then set e.g.:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"

# ---- NextAuth ----
# The canonical URL of your site. Local: http://localhost:3000
NEXTAUTH_URL="http://localhost:3000"
# A random secret used to sign session tokens.
# Generate one with:  openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-long-random-string"
