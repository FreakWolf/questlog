# ------------------------------------------------------------------
# Life RPG — environment variables
# Copy this file to `.env` and fill in the values.
# ------------------------------------------------------------------

# ---- Database (PostgreSQL, e.g. Supabase/Neon) ----
# DATABASE_URL: transaction pooler (port 6543) — used for runtime queries.
#   For Supabase, append ?pgbouncer=true
# DIRECT_URL:   session pooler / direct (port 5432) — used for `prisma db push`
#   and migrations.
# NOTE: if your password contains special characters (@ : / etc.) they must be
# URL-encoded — e.g. "@" becomes "%40".
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# ---- NextAuth ----
# The canonical URL of your site. Local: http://localhost:3000
NEXTAUTH_URL="http://localhost:3000"
# A random secret used to sign session tokens.
# Generate one with:  openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-long-random-string"
